# Copy to .env.local and fill in from the Supabase dashboard
# (Project Settings -> API). .env.local is gitignored.

# Safe to expose to the browser — RLS is what protects the data, not this key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses RLS entirely — never prefix with NEXT_PUBLIC_ and never
# import into a client component. Used by the seed/import scripts and by the
# admin team page (adding people), so the host needs it too.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SERVER ONLY. Contact form delivery (app/actions/inquiry.ts) through Resend.
# INQUIRY_FROM must be on a domain verified in Resend.
RESEND_API_KEY=your-resend-api-key
INQUIRY_FROM="deadAir <messages@deadairrecords.com>"
# Messages go to mgmt@deadairrecords.com (INQUIRY_TO to change it), with each
# artist's management contacts from /admin/artists CC'd.
# INQUIRY_TO=mgmt@deadairrecords.com
